# Guardian Pi — Environment Configuration
# Copy to .env and customize values

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_SECRET_KEY=CHANGE_ME_TO_DIFFERENT_RANDOM_64_CHAR_STRING

# Database
DATABASE_URL=postgresql+asyncpg://guardian:guardian_secret@localhost:5432/guardianpi

# Redis
REDIS_URL=redis://localhost:6379/0

# Agent API Keys (comma-separated)
AGENT_API_KEYS=["gpi_dev_test_key_change_in_production"]

# Telemetry Encryption Key (base64-encoded 32-byte AES key)
# Generate with: python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; import base64; print(base64.b64encode(AESGCM.generate_key(256)).decode())"
TELEMETRY_ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AWS (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_GUARDDUTY_DETECTOR_ID=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
